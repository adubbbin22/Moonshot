# Copy to .env.local (git-ignored) and restart `npx expo start`.

# Where option chains come from:
#   synthetic  made-up prices, no keys (default)
#   yahoo      Yahoo Finance via the local demo server (`npm run market-data`). Demo only.
#   alpaca     straight to Alpaca from the app. DEV BUILDS ONLY: EXPO_PUBLIC_ values
#              are compiled into the bundle, so never ship real keys this way.
#   proxy      our backend (production path), see docs/DATA.md
EXPO_PUBLIC_MARKET_DATA=synthetic

# For EXPO_PUBLIC_MARKET_DATA=alpaca. A free Alpaca account gives the "indicative" feed.
EXPO_PUBLIC_ALPACA_KEY_ID=
EXPO_PUBLIC_ALPACA_SECRET_KEY=
# indicative (free, dev only) or opra (paid, real-time)
EXPO_PUBLIC_ALPACA_FEED=indicative

# For proxy (required) or yahoo (optional: defaults to port 8787 on the Metro host)
EXPO_PUBLIC_MARKET_DATA_URL=

# Drafting a thesis tree from the user's own belief (an LLM, never in the app):
#   off      the screens don't offer it (default)
#   fixture  a canned sample draft, for demos without a backend
#   proxy    our backend. The demo server does it when the Anthropic SDK finds
#            credentials: run `ANTHROPIC_API_KEY=... npm run market-data`.
EXPO_PUBLIC_INTELLIGENCE=off
# For proxy (optional: defaults to port 8787 on the Metro host)
EXPO_PUBLIC_INTELLIGENCE_URL=

# Prediction-market odds (Kalshi, Polymarket) next to each question:
#   sample   made-up quotes, labelled as such (default)
#   proxy    our backend. The demo server fetches live quotes for the markets
#            listed on each question in src/data/events.ts (`markets`).
#   off      hide them
EXPO_PUBLIC_PREDICTION_MARKETS=sample
# For proxy (optional: defaults to port 8787 on the Metro host)
EXPO_PUBLIC_PREDICTION_MARKETS_URL=
